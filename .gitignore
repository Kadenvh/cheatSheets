# ─── PE Scaffolding (excluded from public repo) ───────────────────
# The .claude/ deployable surface and .ava/ DAL runtime are developer
# infrastructure, not product. Product content inside .ava/ is whitelisted.

.claude/

.ava/*
!.ava/learning-schema.sql
!.ava/learning-db.mjs
!.ava/curriculum-export.mjs
!.ava/course-import.mjs

# OpenClaw agent runtime state (dreaming cycles + event logs)
knowledge-agents/*/memory/
knowledge-agents/*/.openclaw/
.openclaw/workspace-state.json

# Personal session chronicle — kept local, not for public consumption
sessions/

# ─── Runtime state ────────────────────────────────────────────────

# Learning database (project-local curriculum runtime state)
# Note: .ava/learning.db* is already covered by .ava/* above, kept here
# for clarity if .ava/ whitelisting changes.
.ava/learning.db
.ava/learning.db-shm
.ava/learning.db-wal

# Obsidian workspace (user-specific UI state, not vault content)
vault/.obsidian/workspace.json
vault/.obsidian/workspaces.json
openClaw_Vault/.obsidian/workspace.json

# Obsidian plugin source (re-installed from community-plugins.json on clone)
# Keep: data.json (user settings), keep community-plugins.json, core-plugins.json
vault/.obsidian/plugins/*/main.js
vault/.obsidian/plugins/*/styles.css
vault/.obsidian/plugins/*/manifest.json
vault/.obsidian/plugins/*/versions.json
vault/.obsidian/plugins/*/data-*.json
vault/.obsidian/plugins/*/.hotreload
vault/.obsidian/plugins/*/lib/
vault/.obsidian/plugins/*/src/
vault/.obsidian/plugins/*/node_modules/

# Obsidian themes (re-install from community)
vault/.obsidian/themes/*/theme.css
vault/.obsidian/themes/*/manifest.json
vault/.obsidian/themes/*/.git/

# ─── Standard exclusions ──────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
build/
.output/
out/

# Environment
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*

# Secrets (defense in depth)
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Legacy / retired directories
docs_archived/
.gitnexus

# PE framework scaffolding (local operating manual, not product)
SYSTEM-OVERVIEW.md

# OpenClaw agent runtime workspace (consolidation pending, SPEC §11)
tutor/
